{
  "rules": {
    ".read": false,
    ".write": false,

    "site": {
      ".read": true,
      ".write": "auth != null && auth.uid === 'lEsVOWrpNQPh06Ii7hMqXgap63J2'",
      "hero": { ".validate": "newData.hasChildren()" },
      "contact": { ".validate": "newData.hasChildren()" }
    },

    "posts": {
      ".indexOn": ["published"],
      ".read": "(auth != null && auth.uid === 'lEsVOWrpNQPh06Ii7hMqXgap63J2') || (query.orderByChild === 'published' && query.equalTo === true)",
      ".write": "auth != null && auth.uid === 'lEsVOWrpNQPh06Ii7hMqXgap63J2'",
      "$slug": {
        ".validate": "$slug.matches(/^[a-z0-9-]{1,80}$/) && newData.hasChildren(['title','date','published'])",
        "title":      { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200" },
        "date":       { ".validate": "newData.isString() && newData.val().length <= 40" },
        "excerpt":    { ".validate": "newData.isString() && newData.val().length <= 500" },
        "tags":       { ".validate": "newData.hasChildren()" },
        "mitre":      { ".validate": "newData.hasChildren()" },
        "platform":   { ".validate": "newData.isString() && newData.val().length <= 80" },
        "difficulty": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "published":  { ".validate": "newData.isBoolean()" },
        "updatedAt":  { ".validate": "newData.isNumber()" },
        "$other":     { ".validate": false }
      }
    },

    "postContent": {
      ".write": "auth != null && auth.uid === 'lEsVOWrpNQPh06Ii7hMqXgap63J2'",
      "$slug": {
        ".read": "(auth != null && auth.uid === 'lEsVOWrpNQPh06Ii7hMqXgap63J2') || root.child('posts').child($slug).child('published').val() === true",
        ".validate": "newData.isString() && newData.val().length <= 200000"
      }
    },

    "stats": {
      ".read": true,
      ".write": "auth != null && auth.uid === 'lEsVOWrpNQPh06Ii7hMqXgap63J2'"
    },

    "visitors": {
      ".read": "auth != null && auth.uid === 'lEsVOWrpNQPh06Ii7hMqXgap63J2'",
      ".write": "auth != null && auth.uid === 'lEsVOWrpNQPh06Ii7hMqXgap63J2'"
    }
  }
}
