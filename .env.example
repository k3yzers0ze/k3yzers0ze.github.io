# Firebase web config — copy to `.env` for local dev (`.env` is gitignored).
# In CI these are injected from GitHub Secrets (see .github/workflows/deploy.yml).
# These VALUES ARE NOT SECRET (they identify the Firebase project); real
# protection comes from database.rules.json. They live outside the repo only
# because Phase 2.4 asked for it.
#
# Find them in: Firebase Console → Project settings → General → "Your apps" → Web app → SDK config.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.europe-west1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
